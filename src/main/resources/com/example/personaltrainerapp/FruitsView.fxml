<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.personaltrainerapp.ui.fruits.FruitsController"
            style="-fx-background-color: #F0F2F5;">

    <!-- Header -->
    <top>
        <HBox style="-fx-padding: 18 24; -fx-background-color: #20232A; -fx-alignment: center-left; -fx-spacing: 12;">
            <Label text="🍎  Fruits - Nutritional information"
                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="statusLabel"
                   style="-fx-text-fill: #AAAAAA; -fx-font-size: 13px;" />
        </HBox>
    </top>

    <!-- Content -->
    <center>
        <VBox spacing="0" style="-fx-padding: 24;">

            <!-- Search bar -->
            <HBox style="-fx-padding: 0 0 14 0;">
                <TextField fx:id="searchField"
                           promptText="Search by name, family or genus..."
                           style="-fx-pref-width: 320; -fx-font-size: 13px; -fx-padding: 8 12;
                                  -fx-background-color: white; -fx-border-color: #E0E0E0;
                                  -fx-border-width: 1;" />
            </HBox>

            <!-- Table -->
            <TableView fx:id="fruitsTable" VBox.vgrow="ALWAYS"
                       style="-fx-background-color: white;
                              -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 3);">

                <columns>
                    <TableColumn fx:id="nameCol"      text="Name"          prefWidth="130" />
                    <TableColumn fx:id="familyCol"    text="Family"        prefWidth="120" />
                    <TableColumn fx:id="genusCol"     text="Genus"         prefWidth="110" />
                    <TableColumn fx:id="caloriesCol"  text="Calories"      prefWidth="80" />
                    <TableColumn fx:id="sugarCol"     text="Sugar (g)"     prefWidth="90" />
                    <TableColumn fx:id="carbsCol"     text="Carbs (g)"     prefWidth="90" />
                    <TableColumn fx:id="proteinCol"   text="Protein (g)"   prefWidth="95" />
                    <TableColumn fx:id="fatCol"       text="Fat (g)"       prefWidth="80" />
                </columns>

                <placeholder>
                    <Label text="No fruits found." style="-fx-text-fill: #AAAAAA; -fx-font-size: 13px;" />
                </placeholder>

            </TableView>

        </VBox>
    </center>

</BorderPane>

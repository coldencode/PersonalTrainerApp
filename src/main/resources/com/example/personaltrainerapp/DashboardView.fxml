<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.personaltrainerapp.ui.dashboard.DashboardController"
            style="-fx-background-color: #F0F2F5;">

    <!-- ── Header ── -->
    <top>
        <HBox style="-fx-padding: 18 24; -fx-background-color: #20232A; -fx-alignment: center-left; -fx-spacing: 12;">
            <Label text="Personal Trainer App"
                   style="-fx-text-fill: #AAAAAA; -fx-font-size: 14px;" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="welcomeLabel"
                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" />
        </HBox>
    </top>

    <!-- ── Main content ── -->
    <center>
        <HBox spacing="20" style="-fx-padding: 30; -fx-alignment: top-center;">

            <!-- Calories card -->
            <VBox spacing="6"
                  style="-fx-background-color: white; -fx-padding: 28; -fx-pref-width: 280; -fx-min-width: 220;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 3);">

                <Label text="Daily Calories"
                       style="-fx-font-size: 13px; -fx-text-fill: #888; -fx-font-weight: bold;" />

                <HBox spacing="6" style="-fx-alignment: baseline-left;">
                    <Label fx:id="calorieGoalLabel"
                           style="-fx-font-size: 52px; -fx-font-weight: bold; -fx-text-fill: #20232A;" />
                    <Label text="kcal"
                           style="-fx-font-size: 16px; -fx-text-fill: #AAA; -fx-padding: 0 0 10 0;" />
                </HBox>

                <Separator style="-fx-padding: 4 0;" />

                <HBox style="-fx-alignment: center-left;">
                    <Label text="Weekly goal"
                           style="-fx-font-size: 12px; -fx-text-fill: #AAA;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button text="✎ Change" onAction="#onChangeWeeklyGoal"
                            style="-fx-background-color: transparent; -fx-text-fill: #888;
                                   -fx-font-size: 11px; -fx-cursor: hand; -fx-padding: 2 6;" />
                </HBox>
                <Label fx:id="weeklyGoalLabel"
                       style="-fx-font-size: 14px; -fx-text-fill: #333; -fx-wrap-text: true;" />

                <Separator style="-fx-padding: 4 0;" />

                <Label text="TODAY'S INTAKE"
                       style="-fx-font-size: 11px; -fx-text-fill: #AAA; -fx-font-weight: bold;" />

                <HBox spacing="4" style="-fx-alignment: baseline-left;">
                    <Label fx:id="intakeLabel"
                           style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #20232A;" />
                    <Label text="kcal"
                           style="-fx-font-size: 13px; -fx-text-fill: #AAA; -fx-padding: 0 0 6 0;" />
                </HBox>

                <Label fx:id="remainingLabel" />

                <VBox spacing="6" style="-fx-padding: 6 0 0 0;">
                    <Button text="🍳  Log Breakfast" onAction="#onLogBreakfast" maxWidth="Infinity"
                            style="-fx-background-color: #F0F2F5; -fx-text-fill: #333;
                                   -fx-font-size: 13px; -fx-padding: 9 12; -fx-cursor: hand;
                                   -fx-alignment: center-left;" />
                    <Button text="🥗  Log Lunch" onAction="#onLogLunch" maxWidth="Infinity"
                            style="-fx-background-color: #F0F2F5; -fx-text-fill: #333;
                                   -fx-font-size: 13px; -fx-padding: 9 12; -fx-cursor: hand;
                                   -fx-alignment: center-left;" />
                    <Button text="🍽  Log Dinner" onAction="#onLogDinner" maxWidth="Infinity"
                            style="-fx-background-color: #F0F2F5; -fx-text-fill: #333;
                                   -fx-font-size: 13px; -fx-padding: 9 12; -fx-cursor: hand;
                                   -fx-alignment: center-left;" />
                </VBox>

            </VBox>

            <!-- BMI card -->
            <VBox spacing="6"
                  style="-fx-background-color: white; -fx-padding: 28; -fx-pref-width: 260; -fx-min-width: 200;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 3);">

                <Label text="BMI"
                       style="-fx-font-size: 13px; -fx-text-fill: #888; -fx-font-weight: bold;" />

                <HBox spacing="6" style="-fx-alignment: baseline-left;">
                    <Label fx:id="bmiValueLabel"
                           style="-fx-font-size: 52px; -fx-font-weight: bold; -fx-text-fill: #20232A;" />
                </HBox>

                <Label fx:id="bmiCategoryLabel"
                       style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #555;" />

                <Separator style="-fx-padding: 4 0;" />

                <Label text="Underweight  &lt; 18.5"  style="-fx-font-size: 12px; -fx-text-fill: #AAA;" />
                <Label text="Normal          18.5 – 24.9" style="-fx-font-size: 12px; -fx-text-fill: #AAA;" />
                <Label text="Overweight   25 – 29.9"  style="-fx-font-size: 12px; -fx-text-fill: #AAA;" />
                <Label text="Obese           ≥ 30"        style="-fx-font-size: 12px; -fx-text-fill: #AAA;" />

            </VBox>

            <!-- Weight card -->
            <VBox spacing="10" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-padding: 28;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 3);">

                <HBox style="-fx-alignment: center-left;">
                    <Label text="Weight"
                           style="-fx-font-size: 13px; -fx-text-fill: #888; -fx-font-weight: bold;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button text="+ Add Weight" onAction="#onAddWeight"
                            style="-fx-background-color: #20232A; -fx-text-fill: white;
                                   -fx-font-size: 13px; -fx-padding: 6 16; -fx-cursor: hand;" />
                </HBox>

                <LineChart fx:id="weightChart" VBox.vgrow="ALWAYS"
                           legendVisible="false" animated="false"
                           style="-fx-padding: 0;">
                    <xAxis>
                        <CategoryAxis label="Date" />
                    </xAxis>
                    <yAxis>
                        <NumberAxis label="kg" autoRanging="true" />
                    </yAxis>
                </LineChart>

                <Separator style="-fx-padding: 4 0;" />

                <Label text="CALORIE HISTORY"
                       style="-fx-font-size: 11px; -fx-text-fill: #AAA; -fx-font-weight: bold;" />

                <LineChart fx:id="calorieHistoryChart" VBox.vgrow="ALWAYS"
                           animated="false" style="-fx-padding: 0;">
                    <xAxis>
                        <CategoryAxis label="Date" tickLabelRotation="45" />
                    </xAxis>
                    <yAxis>
                        <NumberAxis label="kcal" autoRanging="true" />
                    </yAxis>
                </LineChart>

            </VBox>

        </HBox>
    </center>

</BorderPane>
